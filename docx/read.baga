// docx/read.baga — WordprocessingML plain text extract from word/document.xml.

import "xmlbaga/xml.baga"
import "bufbaga/buf.baga"
import "../core/names.baga"
import "../opc/package.baga"
import "std/str/str.baga"

fn docx_extract_xml(src: str) -> str {
    let p = xml_parser(src)
    let mut b = buf_new()
    let mut in_t: i64 = 0
    let mut para_has: i64 = 0
    let mut done: i64 = 0
    while done == 0 {
        let ev = xml_next(p)
        if ev.kind == 0 {
            done = 1
        } else {
            if ev.kind == 0 - 1 {
                done = 1
            } else {
                if ev.kind == 1 {
                    let loc = office_local(ev.name)
                    if loc == "t" {
                        in_t = 1
                    }
                    if loc == "tab" {
                        b = buf_push(b, "\t")
                        para_has = 1
                    }
                    if loc == "br" || loc == "cr" {
                        b = buf_push(b, "\n")
                        para_has = 1
                    }
                } else {
                    if ev.kind == 2 {
                        let loc = office_local(ev.name)
                        if loc == "t" {
                            in_t = 0
                        }
                        if loc == "p" {
                            b = buf_push(b, "\n")
                            para_has = 0
                        }
                    } else {
                        if ev.kind == 3 {
                            if in_t == 1 {
                                b = buf_push(b, ev.text)
                                para_has = 1
                            }
                        }
                    }
                }
            }
        }
    }
    return buf_str(b)
}

fn docx_plain_text(pkg: OpcPackage) -> str {
    if pkg.ok == 0 {
        return ""
    }
    let src = opc_part_text(pkg, "word/document.xml")
    if src == "" {
        return ""
    }
    return docx_extract_xml(src)
}

// ---------- markdown extract (headings + inline bold/italic) ----------

fn docx_md_attr(ev: XmlEvent, key: str) -> str {
    if map_has(ev.attrs, key) == 1 {
        return map_get(ev.attrs, key)
    }
    return ""
}

// <w:b w:val="false"/> turns a property off; bare <w:b/> turns it on.
fn docx_md_on(ev: XmlEvent) -> i64 {
    let v = docx_md_attr(ev, "w:val")
    if v == "false" || v == "False" || v == "0" || v == "off" || v == "Off" {
        return 0
    }
    return 1
}

// Paragraph style id → heading level ("Heading1", "heading 2", …).
fn docx_md_style_level(style: str) -> i64 {
    let mut s = str_replace(str_trim(style), " ", "")
    if str_starts_with(s, "Heading") {
        s = substr(s, 7, len(s))
    } else {
        if str_starts_with(s, "heading") {
            s = substr(s, 7, len(s))
        } else {
            return 0
        }
    }
    let n = parse_int(s)
    if n >= 1 && n <= 6 {
        return n
    }
    return 0
}

fn docx_md_wrap(text: str, b: i64, i: i64) -> str {
    if text == "" {
        return ""
    }
    if b == 1 && i == 1 {
        return concat(concat("***", text), "***")
    }
    if b == 1 {
        return concat(concat("**", text), "**")
    }
    if i == 1 {
        return concat(concat("*", text), "*")
    }
    return text
}

fn docx_md_heading_prefix(level: i64) -> str {
    let mut b = buf_new()
    let mut i: i64 = 0
    while i < level {
        b = buf_push(b, "#")
        i = i + 1
    }
    return concat(buf_str(b), " ")
}

// word/document.xml → markdown: headings via pStyle/outlineLvl, runs
// wrapped in ** / * / *** by their rPr. Paragraphs separated by blank lines.
fn docx_markdown_xml(src: str) -> str {
    let p = xml_parser(src)
    let mut out = buf_new()
    let mut para = buf_new()
    let mut in_t: i64 = 0
    let mut in_r: i64 = 0
    let mut in_rpr: i64 = 0
    let mut cur_b: i64 = 0
    let mut cur_i: i64 = 0
    let mut style_lvl: i64 = 0
    let mut outline_lvl: i64 = 0
    let mut done: i64 = 0
    while done == 0 {
        let ev = xml_next(p)
        if ev.kind == 0 || ev.kind == 0 - 1 {
            done = 1
        } else {
            if ev.kind == 1 {
                let loc = office_local(ev.name)
                if loc == "r" {
                    in_r = 1
                    cur_b = 0
                    cur_i = 0
                }
                if loc == "rPr" && in_r == 1 {
                    in_rpr = 1
                }
                if in_rpr == 1 && loc == "b" {
                    cur_b = docx_md_on(ev)
                }
                if in_rpr == 1 && loc == "i" {
                    cur_i = docx_md_on(ev)
                }
                if loc == "pStyle" {
                    let lvl = docx_md_style_level(docx_md_attr(ev, "w:val"))
                    if lvl > 0 {
                        style_lvl = lvl
                    }
                }
                if loc == "outlineLvl" {
                    let n = parse_int(docx_md_attr(ev, "w:val"))
                    if n >= 0 && n <= 5 {
                        outline_lvl = n + 1
                    }
                }
                if loc == "t" {
                    in_t = 1
                }
                if loc == "tab" {
                    para = buf_push(para, "\t")
                }
                if loc == "br" || loc == "cr" {
                    para = buf_push(para, "\n")
                }
            } else {
                if ev.kind == 2 {
                    let loc = office_local(ev.name)
                    if loc == "t" {
                        in_t = 0
                    }
                    if loc == "rPr" {
                        in_rpr = 0
                    }
                    if loc == "r" {
                        in_r = 0
                    }
                    if loc == "p" {
                        let mut lvl = style_lvl
                        if outline_lvl > 0 {
                            lvl = outline_lvl
                        }
                        let content = buf_str(para)
                        para = buf_new()
                        if str_trim(content) != "" {
                            if lvl > 0 {
                                out = buf_push(out, docx_md_heading_prefix(lvl))
                            }
                            out = buf_push(out, content)
                            out = buf_push(out, "\n\n")
                        }
                        style_lvl = 0
                        outline_lvl = 0
                    }
                } else {
                    if ev.kind == 3 && in_t == 1 {
                        para = buf_push(para, docx_md_wrap(ev.text, cur_b, cur_i))
                    }
                }
            }
        }
    }
    return buf_str(out)
}

fn docx_markdown(pkg: OpcPackage) -> str {
    if pkg.ok == 0 {
        return ""
    }
    let src = opc_part_text(pkg, "word/document.xml")
    if src == "" {
        return ""
    }
    return docx_markdown_xml(src)
}
