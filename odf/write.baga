// odf/write.baga — minimal ODT / ODS (store ZIP). No presentations.

import "zipbaga/archive.baga"
import "xmlbaga/xml.baga"
import "bufbaga/buf.baga"
import "../core/numcell.baga"
import "std/str/str.baga"

fn odf_esc(s: str) -> str {
    return xml_escape_text(s)
}

fn odf_manifest(entries: Vec<str>, mimes: Vec<str>) -> str {
    let mut b = buf_new()
    b = buf_push(b, "<?xml version=\"1.0\" encoding=\"UTF-8\"?>")
    b = buf_push(b, "<manifest:manifest xmlns:manifest=\"urn:oasis:names:tc:opendocument:xmlns:manifest:1.0\" manifest:version=\"1.2\">")
    let mut i: i64 = 0
    while i < vec_len(entries) {
        b = buf_push(b, "<manifest:file-entry manifest:full-path=\"")
        b = buf_push(b, vec_get(entries, i))
        b = buf_push(b, "\" manifest:media-type=\"")
        b = buf_push(b, vec_get(mimes, i))
        b = buf_push(b, "\"/>")
        i = i + 1
    }
    b = buf_push(b, "</manifest:manifest>")
    return buf_str(b)
}

// Body: newlines → text:p paragraphs. Optional title as first heading.
fn odt_content_xml(title: str, body: str) -> str {
    let mut b = buf_new()
    b = buf_push(b, "<?xml version=\"1.0\" encoding=\"UTF-8\"?>")
    b = buf_push(b, "<office:document-content xmlns:office=\"urn:oasis:names:tc:opendocument:xmlns:office:1.0\" xmlns:text=\"urn:oasis:names:tc:opendocument:xmlns:text:1.0\" office:version=\"1.2\">")
    b = buf_push(b, "<office:body><office:text>")
    if title != "" {
        b = buf_push(b, "<text:h text:outline-level=\"1\">")
        b = buf_push(b, odf_esc(title))
        b = buf_push(b, "</text:h>")
    }
    let lines = str_split(body, "\n")
    let mut i: i64 = 0
    while i < vec_len(lines) {
        b = buf_push(b, "<text:p>")
        b = buf_push(b, odf_esc(vec_get(lines, i)))
        b = buf_push(b, "</text:p>")
        i = i + 1
    }
    b = buf_push(b, "</office:text></office:body></office:document-content>")
    return buf_str(b)
}

fn odt_report_content_xml(title: str, meta: str, rows: Vec<str>) -> str {
    let mut b = buf_new()
    b = buf_push(b, "<?xml version=\"1.0\" encoding=\"UTF-8\"?>")
    b = buf_push(b, "<office:document-content xmlns:office=\"urn:oasis:names:tc:opendocument:xmlns:office:1.0\" xmlns:text=\"urn:oasis:names:tc:opendocument:xmlns:text:1.0\" xmlns:table=\"urn:oasis:names:tc:opendocument:xmlns:table:1.0\" office:version=\"1.2\">")
    b = buf_push(b, "<office:body><office:text>")
    if title != "" {
        b = buf_push(b, "<text:h text:outline-level=\"1\">")
        b = buf_push(b, odf_esc(title))
        b = buf_push(b, "</text:h>")
    }
    if meta != "" {
        b = buf_push(b, "<text:p>")
        b = buf_push(b, odf_esc(meta))
        b = buf_push(b, "</text:p>")
    }
    if vec_len(rows) > 0 {
        b = buf_push(b, "<table:table table:name=\"Report\">")
        let mut r: i64 = 0
        while r < vec_len(rows) {
            let cells = str_split(vec_get(rows, r), "\t")
            b = buf_push(b, "<table:table-row>")
            let mut c: i64 = 0
            while c < vec_len(cells) {
                b = buf_push(b, "<table:table-cell office:value-type=\"string\"><text:p>")
                b = buf_push(b, odf_esc(vec_get(cells, c)))
                b = buf_push(b, "</text:p></table:table-cell>")
                c = c + 1
            }
            b = buf_push(b, "</table:table-row>")
            r = r + 1
        }
        b = buf_push(b, "</table:table>")
    }
    b = buf_push(b, "</office:text></office:body></office:document-content>")
    return buf_str(b)
}

fn odt_font_decls() -> str {
    return "<office:font-face-decls><style:font-face style:name=\"DejaVuSans\" svg:font-family=\"&apos;DejaVu Sans&apos;\" style:font-family-generic=\"swiss\" style:font-pitch=\"variable\"/></office:font-face-decls>"
}

fn odt_styles_xml() -> str {
    let mut b = buf_new()
    b = buf_push(b, "<?xml version=\"1.0\" encoding=\"UTF-8\"?>")
    b = buf_push(b, "<office:document-styles xmlns:office=\"urn:oasis:names:tc:opendocument:xmlns:office:1.0\" xmlns:style=\"urn:oasis:names:tc:opendocument:xmlns:style:1.0\" xmlns:text=\"urn:oasis:names:tc:opendocument:xmlns:text:1.0\" xmlns:fo=\"urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0\" xmlns:svg=\"urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0\" xmlns:table=\"urn:oasis:names:tc:opendocument:xmlns:table:1.0\" office:version=\"1.2\">")
    b = buf_push(b, odt_font_decls())
    b = buf_push(b, "<office:styles>")
    b = buf_push(b, "<style:default-style style:family=\"paragraph\"><style:paragraph-properties fo:hyphenate=\"false\"/><style:text-properties style:font-name=\"DejaVuSans\" fo:font-size=\"10pt\"/></style:default-style>")
    b = buf_push(b, "<style:style style:name=\"Standard\" style:family=\"paragraph\" style:class=\"text\"><style:paragraph-properties fo:margin-top=\"0cm\" fo:margin-bottom=\"0.12cm\"/><style:text-properties style:font-name=\"DejaVuSans\" fo:font-size=\"10pt\"/></style:style>")
    b = buf_push(b, "<style:style style:name=\"Heading\" style:family=\"paragraph\" style:parent-style-name=\"Standard\" style:next-style-name=\"Standard\"><style:paragraph-properties fo:margin-top=\"0.2cm\" fo:margin-bottom=\"0.15cm\"/><style:text-properties fo:font-size=\"16pt\" fo:font-weight=\"bold\"/></style:style>")
    b = buf_push(b, "<style:style style:name=\"Heading_20_1\" style:display-name=\"Heading 1\" style:family=\"paragraph\" style:parent-style-name=\"Heading\" style:default-outline-level=\"1\"><style:text-properties fo:font-size=\"16pt\" fo:font-weight=\"bold\"/></style:style>")
    b = buf_push(b, "<style:style style:name=\"Table_20_Contents\" style:display-name=\"Table Contents\" style:family=\"paragraph\" style:parent-style-name=\"Standard\"><style:paragraph-properties fo:margin-top=\"0cm\" fo:margin-bottom=\"0cm\"/><style:text-properties fo:font-size=\"9pt\"/></style:style>")
    b = buf_push(b, "<style:style style:name=\"Table_20_Heading\" style:display-name=\"Table Heading\" style:family=\"paragraph\" style:parent-style-name=\"Table_20_Contents\"><style:text-properties fo:font-weight=\"bold\"/></style:style>")
    b = buf_push(b, "</office:styles>")
    b = buf_push(b, "<office:automatic-styles><style:page-layout style:name=\"Mpm1\"><style:page-layout-properties fo:page-width=\"21cm\" fo:page-height=\"29.7cm\" style:print-orientation=\"portrait\" fo:margin-top=\"1.5cm\" fo:margin-bottom=\"1.5cm\" fo:margin-left=\"1.5cm\" fo:margin-right=\"1.5cm\"/></style:page-layout></office:automatic-styles>")
    b = buf_push(b, "<office:master-styles><style:master-page style:name=\"Standard\" style:page-layout-name=\"Mpm1\"/></office:master-styles>")
    b = buf_push(b, "</office:document-styles>")
    return buf_str(b)
}

fn odt_meta_xml() -> str {
    return "<?xml version=\"1.0\" encoding=\"UTF-8\"?><office:document-meta xmlns:office=\"urn:oasis:names:tc:opendocument:xmlns:office:1.0\" xmlns:meta=\"urn:oasis:names:tc:opendocument:xmlns:meta:1.0\" office:version=\"1.2\"><office:meta><meta:generator>officebaga</meta:generator></office:meta></office:document-meta>"
}

fn odt_col_width(ncols: i64) -> str {
    if ncols <= 1 {
        return "17cm"
    }
    if ncols == 2 {
        return "8.5cm"
    }
    if ncols == 3 {
        return "5.66cm"
    }
    if ncols == 4 {
        return "4.25cm"
    }
    if ncols == 5 {
        return "3.4cm"
    }
    if ncols == 6 {
        return "2.83cm"
    }
    if ncols == 7 {
        return "2.42cm"
    }
    if ncols == 8 {
        return "2.12cm"
    }
    return "1.7cm"
}

fn odt_col_width_at(ncols: i64, col: i64) -> str {
    if ncols == 6 {
        if col == 0 {
            return "1.4cm"
        }
        if col == 1 {
            return "7.2cm"
        }
        if col == 2 {
            return "1.8cm"
        }
        if col == 3 {
            return "1.8cm"
        }
        if col == 4 {
            return "2.4cm"
        }
        return "2.4cm"
    }
    return odt_col_width(ncols)
}

fn odt_tsv_ncols(text: str) -> i64 {
    let raw = str_split(text, "\n")
    let mut maxc: i64 = 1
    let mut r: i64 = 0
    while r < vec_len(raw) {
        let line = vec_get(raw, r)
        if r == vec_len(raw) - 1 && line == "" {
            r = r + 1
        } else {
            let n = vec_len(str_split(line, "\t"))
            if n > maxc {
                maxc = n
            }
            r = r + 1
        }
    }
    return maxc
}

fn odt_cell_border() -> str {
    return "fo:padding=\"0.08cm\" fo:border-top=\"0.74pt solid #000000\" fo:border-bottom=\"0.74pt solid #000000\" fo:border-left=\"0.74pt solid #000000\" fo:border-right=\"0.74pt solid #000000\" fo:wrap-option=\"wrap\" style:vertical-align=\"top\""
}

fn odt_doc_content_xml(kinds: Vec<i64>, texts: Vec<str>) -> str {
    let mut b = buf_new()
    b = buf_push(b, "<?xml version=\"1.0\" encoding=\"UTF-8\"?>")
    b = buf_push(b, "<office:document-content xmlns:office=\"urn:oasis:names:tc:opendocument:xmlns:office:1.0\" xmlns:text=\"urn:oasis:names:tc:opendocument:xmlns:text:1.0\" xmlns:table=\"urn:oasis:names:tc:opendocument:xmlns:table:1.0\" xmlns:style=\"urn:oasis:names:tc:opendocument:xmlns:style:1.0\" xmlns:fo=\"urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0\" xmlns:svg=\"urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0\" office:version=\"1.2\">")
    b = buf_push(b, odt_font_decls())
    b = buf_push(b, "<office:automatic-styles>")
    let mut i: i64 = 0
    let mut tn: i64 = 1
    while i < vec_len(kinds) {
        if vec_get(kinds, i) == 3 {
            let ncols = odt_tsv_ncols(vec_get(texts, i))
            b = buf_push(b, "<style:style style:name=\"T")
            b = buf_push_i64(b, tn)
            b = buf_push(b, "\" style:family=\"table\"><style:table-properties style:width=\"17cm\" table:align=\"margins\" table:border-model=\"collapsing\"/></style:style>")
            let mut c: i64 = 0
            while c < ncols {
                b = buf_push(b, "<style:style style:name=\"T")
                b = buf_push_i64(b, tn)
                b = buf_push(b, "C")
                b = buf_push_i64(b, c)
                b = buf_push(b, "\" style:family=\"table-column\"><style:table-column-properties style:column-width=\"")
                b = buf_push(b, odt_col_width_at(ncols, c))
                b = buf_push(b, "\"/></style:style>")
                c = c + 1
            }
            tn = tn + 1
        }
        i = i + 1
    }
    b = buf_push(b, "<style:style style:name=\"InvCel\" style:family=\"table-cell\"><style:table-cell-properties ")
    b = buf_push(b, odt_cell_border())
    b = buf_push(b, "/></style:style>")
    b = buf_push(b, "<style:style style:name=\"InvCelH\" style:family=\"table-cell\"><style:table-cell-properties ")
    b = buf_push(b, odt_cell_border())
    b = buf_push(b, " fo:background-color=\"#e8e8e8\"/></style:style>")
    b = buf_push(b, "</office:automatic-styles>")
    b = buf_push(b, "<office:body><office:text>")
    i = 0
    tn = 1
    while i < vec_len(kinds) {
        let kind = vec_get(kinds, i)
        let text = vec_get(texts, i)
        if kind == 1 {
            b = buf_push(b, "<text:h text:style-name=\"Heading_20_1\" text:outline-level=\"1\">")
            b = buf_push(b, odf_esc(text))
            b = buf_push(b, "</text:h>")
        }
        if kind == 2 {
            b = buf_push(b, "<text:p text:style-name=\"Standard\">")
            b = buf_push(b, odf_esc(text))
            b = buf_push(b, "</text:p>")
        }
        if kind == 3 {
            let raw = str_split(text, "\n")
            let ncols = odt_tsv_ncols(text)
            b = buf_push(b, "<table:table table:name=\"T")
            b = buf_push_i64(b, tn)
            b = buf_push(b, "\" table:style-name=\"T")
            b = buf_push_i64(b, tn)
            b = buf_push(b, "\">")
            let mut c: i64 = 0
            while c < ncols {
                b = buf_push(b, "<table:table-column table:style-name=\"T")
                b = buf_push_i64(b, tn)
                b = buf_push(b, "C")
                b = buf_push_i64(b, c)
                b = buf_push(b, "\"/>")
                c = c + 1
            }
            tn = tn + 1
            let mut r: i64 = 0
            let mut vis: i64 = 0
            while r < vec_len(raw) {
                let line = vec_get(raw, r)
                if r == vec_len(raw) - 1 && line == "" {
                    r = r + 1
                } else {
                    let cells = str_split(line, "\t")
                    if vis == 0 {
                        b = buf_push(b, "<table:table-header-rows>")
                    }
                    b = buf_push(b, "<table:table-row>")
                    c = 0
                    while c < ncols {
                        let mut cs = "InvCel"
                        let mut ps = "Table_20_Contents"
                        if vis == 0 {
                            cs = "InvCelH"
                            ps = "Table_20_Heading"
                        }
                        let mut val = ""
                        if c < vec_len(cells) {
                            val = vec_get(cells, c)
                        }
                        b = buf_push(b, "<table:table-cell table:style-name=\"")
                        b = buf_push(b, cs)
                        b = buf_push(b, "\" office:value-type=\"string\"><text:p text:style-name=\"")
                        b = buf_push(b, ps)
                        b = buf_push(b, "\">")
                        b = buf_push(b, odf_esc(val))
                        b = buf_push(b, "</text:p></table:table-cell>")
                        c = c + 1
                    }
                    b = buf_push(b, "</table:table-row>")
                    if vis == 0 {
                        b = buf_push(b, "</table:table-header-rows>")
                    }
                    vis = vis + 1
                    r = r + 1
                }
            }
            b = buf_push(b, "</table:table>")
            b = buf_push(b, "<text:p text:style-name=\"Standard\"/>")
        }
        i = i + 1
    }
    b = buf_push(b, "</office:text></office:body></office:document-content>")
    return buf_str(b)
}

fn odt_doc_bytes(kinds: Vec<i64>, texts: Vec<str>) -> bytes {
    let mt = "application/vnd.oasis.opendocument.text"
    let names = vec_new()
    let parts = vec_new()
    vec_push(names, "mimetype")
    vec_push(parts, bytes_of_str(mt))
    vec_push(names, "content.xml")
    vec_push(parts, bytes_of_str(odt_doc_content_xml(kinds, texts)))
    vec_push(names, "styles.xml")
    vec_push(parts, bytes_of_str(odt_styles_xml()))
    vec_push(names, "meta.xml")
    vec_push(parts, bytes_of_str(odt_meta_xml()))
    let man_paths = vec_new()
    let man_mimes = vec_new()
    vec_push(man_paths, "/")
    vec_push(man_mimes, mt)
    vec_push(man_paths, "content.xml")
    vec_push(man_mimes, "text/xml")
    vec_push(man_paths, "styles.xml")
    vec_push(man_mimes, "text/xml")
    vec_push(man_paths, "meta.xml")
    vec_push(man_mimes, "text/xml")
    vec_push(names, "META-INF/manifest.xml")
    vec_push(parts, bytes_of_str(odf_manifest(man_paths, man_mimes)))
    let methods = vec_new()
    vec_push(methods, 0)
    vec_push(methods, 8)
    vec_push(methods, 8)
    vec_push(methods, 8)
    vec_push(methods, 8)
    return zip_write_methods(names, parts, methods)
}

fn odt_report_bytes(title: str, meta: str, rows: Vec<str>) -> bytes {
    let mt = "application/vnd.oasis.opendocument.text"
    let names = vec_new()
    let parts = vec_new()
    vec_push(names, "mimetype")
    vec_push(parts, bytes_of_str(mt))
    vec_push(names, "content.xml")
    vec_push(parts, bytes_of_str(odt_report_content_xml(title, meta, rows)))
    let man_paths = vec_new()
    let man_mimes = vec_new()
    vec_push(man_paths, "/")
    vec_push(man_mimes, mt)
    vec_push(man_paths, "content.xml")
    vec_push(man_mimes, "text/xml")
    vec_push(names, "META-INF/manifest.xml")
    vec_push(parts, bytes_of_str(odf_manifest(man_paths, man_mimes)))
    let methods = vec_new()
    vec_push(methods, 0)
    vec_push(methods, 8)
    vec_push(methods, 8)
    return zip_write_methods(names, parts, methods)
}

fn odt_create_bytes(title: str, body: str) -> bytes {
    let mt = "application/vnd.oasis.opendocument.text"
    let names = vec_new()
    let parts = vec_new()
    // mimetype should be first and stored (ZIP store) — we only have store.
    vec_push(names, "mimetype")
    vec_push(parts, bytes_of_str(mt))
    vec_push(names, "content.xml")
    vec_push(parts, bytes_of_str(odt_content_xml(title, body)))
    let man_paths = vec_new()
    let man_mimes = vec_new()
    vec_push(man_paths, "/")
    vec_push(man_mimes, mt)
    vec_push(man_paths, "content.xml")
    vec_push(man_mimes, "text/xml")
    vec_push(names, "META-INF/manifest.xml")
    vec_push(parts, bytes_of_str(odf_manifest(man_paths, man_mimes)))
    // ODF: mimetype must be first + stored; other parts may deflate.
    let methods = vec_new()
    vec_push(methods, 0)
    vec_push(methods, 8)
    vec_push(methods, 8)
    return zip_write_methods(names, parts, methods)
}

// TSV rows → table:table
fn ods_content_xml(tsv: str) -> str {
    let rows = str_split(tsv, "\n")
    let mut n = vec_len(rows)
    if n > 0 {
        if vec_get(rows, n - 1) == "" {
            n = n - 1
        }
    }
    let mut b = buf_new()
    b = buf_push(b, "<?xml version=\"1.0\" encoding=\"UTF-8\"?>")
    b = buf_push(b, "<office:document-content xmlns:office=\"urn:oasis:names:tc:opendocument:xmlns:office:1.0\" xmlns:table=\"urn:oasis:names:tc:opendocument:xmlns:table:1.0\" xmlns:text=\"urn:oasis:names:tc:opendocument:xmlns:text:1.0\" office:version=\"1.2\">")
    b = buf_push(b, "<office:body><office:spreadsheet><table:table table:name=\"Sheet1\">")
    let mut r: i64 = 0
    while r < n {
        let cells = str_split(vec_get(rows, r), "\t")
        b = buf_push(b, "<table:table-row>")
        let mut c: i64 = 0
        while c < vec_len(cells) {
            let val = vec_get(cells, c)
            if office_cell_is_num(val) == 1 {
                b = buf_push(b, "<table:table-cell office:value-type=\"float\" office:value=\"")
                b = buf_push(b, office_cell_xml_value(val))
                b = buf_push(b, "\"><text:p>")
                b = buf_push(b, odf_esc(office_cell_bg_text(office_cell_xml_value(val))))
                b = buf_push(b, "</text:p></table:table-cell>")
            } else {
                b = buf_push(b, "<table:table-cell office:value-type=\"string\"><text:p>")
                b = buf_push(b, odf_esc(val))
                b = buf_push(b, "</text:p></table:table-cell>")
            }
            c = c + 1
        }
        b = buf_push(b, "</table:table-row>")
        r = r + 1
    }
    b = buf_push(b, "</table:table></office:spreadsheet></office:body></office:document-content>")
    return buf_str(b)
}

fn ods_create_bytes(tsv: str) -> bytes {
    let mt = "application/vnd.oasis.opendocument.spreadsheet"
    let names = vec_new()
    let parts = vec_new()
    vec_push(names, "mimetype")
    vec_push(parts, bytes_of_str(mt))
    vec_push(names, "content.xml")
    vec_push(parts, bytes_of_str(ods_content_xml(tsv)))
    let man_paths = vec_new()
    let man_mimes = vec_new()
    vec_push(man_paths, "/")
    vec_push(man_mimes, mt)
    vec_push(man_paths, "content.xml")
    vec_push(man_mimes, "text/xml")
    vec_push(names, "META-INF/manifest.xml")
    vec_push(parts, bytes_of_str(odf_manifest(man_paths, man_mimes)))
    let methods = vec_new()
    vec_push(methods, 0)
    vec_push(methods, 8)
    vec_push(methods, 8)
    return zip_write_methods(names, parts, methods)
}
