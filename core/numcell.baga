// core/numcell.baga — TSV клетка като число за XLSX/ODS.
// XML стойността е с точка; екранният текст може да е със запетая (BG).
// Водещи нули (0001) остават текст — номера на документи.

import "std/str/str.baga"

fn office_cell_is_num(s: str) -> i64 {
    let n = len(s)
    if n == 0 {
        return 0
    }
    let mut i: i64 = 0
    if char_at(s, 0) == 45 {
        if n == 1 {
            return 0
        }
        i = 1
    }
    let mut sep: i64 = 0
    let mut digits: i64 = 0
    let mut lead0: i64 = 0
    if char_at(s, i) == 48 {
        lead0 = 1
    }
    while i < n {
        let c = char_at(s, i)
        if c == 46 || c == 44 {
            if sep != 0 {
                return 0
            }
            sep = c
        } else {
            if c < 48 || c > 57 {
                return 0
            }
            digits = digits + 1
        }
        i = i + 1
    }
    if digits < 1 {
        return 0
    }
    if sep == 0 && lead0 == 1 && digits > 1 {
        return 0
    }
    if sep != 0 && lead0 == 1 {
        let mut j: i64 = 0
        if char_at(s, 0) == 45 {
            j = 1
        }
        if j + 1 < n {
            if char_at(s, j + 1) != sep {
                return 0
            }
        }
    }
    return 1
}

fn office_cell_xml_value(s: str) -> str {
    return str_replace(s, ",", ".")
}

fn office_cell_bg_text(s: str) -> str {
    return str_replace(s, ".", ",")
}
